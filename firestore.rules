rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function admin(){return request.auth!=null&&request.auth.token.email=='thesnkgraphic@email.com';}
 function staff(){return request.auth!=null&&exists(/databases/$(d)/documents/staff/$(request.auth.uid));}
 function me(){return get(/databases/$(d)/documents/staff/$(request.auth.uid)).data;}
 match /site/{x}{allow read:if true;allow write:if admin();}
 match /faq/{x}{allow read:if true;allow write:if admin();}
 match /showcase/{x}{allow read:if true;allow write:if admin();}
 match /clicks/{x}{allow read:if admin();allow create:if request.resource.data.keys().hasOnly(['n'])&&request.resource.data.n==1;allow update:if request.resource.data.keys().hasOnly(['n'])&&request.resource.data.n==resource.data.n+1;}
 match /team/{x}{allow read:if true;allow write:if admin();
  allow update:if staff()&&me().memberId==x&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusNote']);}
 match /staff/{u}{allow read:if admin()||request.auth.uid==u;allow write:if admin();}
 match /threads/{s}{allow read:if admin()||(staff()&&me().memberId==resource.data.mid);allow create:if true;
  allow update:if admin()||(staff()&&me().memberId==resource.data.mid)||((!('mid' in resource.data)||request.resource.data.mid==resource.data.mid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','from','by','t','member','mid','issue','site','no','ct','rate']));allow delete:if admin();
  match /rtc/{r}{allow read,delete:if true;allow create,update:if request.resource.data.keys().hasOnly(['offer','answer','t']);}
  match /msgs/{m}{allow read,create:if !s.matches('room.*')||admin()||staff();allow update,delete:if admin();}}
}}
